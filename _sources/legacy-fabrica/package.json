{
  "name": "fabrica",
  "version": "1.0.0",
  "description": "Stop prompting if you run Business & Coding sessions manualy with 80-hour work weeks, files & spreadsheets.\nRun on 24/7 AI Autonomy and Scale. Draft, plan, execute, and verify -- Monitor from a single Dashboard, with zero technical setup.\nFabrica. your Next AI EXIT.",
  "main": "server.ts",
  "type": "module",
  "workspaces": [
    "frontend-next"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build:frontend": "NODE_ENV=production npm run build --prefix frontend-next",
    "build:runner": "esbuild src/runner/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/runner/server.js",
    "build": "BUILDING=1 npm run build:frontend && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run build:runner",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@google-cloud/discoveryengine": "^2.8.0",
    "@google-cloud/run": "^3.3.0",
    "@google-cloud/storage": "^7.21.0",
    "@supabase/supabase-js": "2.48.0",
    "@types/jszip": "^3.4.1",
    "cheerio": "^1.2.0",
    "cross-env": "^7.0.3",
    "d3": "^7.9.0",
    "express": "^4.19.2",
    "firebase": "^12.16.0",
    "jszip": "^3.10.1",
    "ws": "^8.21.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.21.5",
    "tsx": "^4.15.6",
    "typescript": "^7.0.2"
  }
}
